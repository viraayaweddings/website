RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="queries@viraayaweddings.com"
RESEND_REPLY_TO="info@viraayaweddings.com"
RESEND_TO_EMAIL="viraayaweddings@gmail.com"
LEAD_EMAIL_SUBJECT="Website Query"
# Optional for local corporate-proxy testing only. Do not enable in production.
RESEND_ALLOW_INSECURE_LOCAL_TLS="false"

# PostgreSQL (Neon, Vercel Postgres, or any Postgres-compatible provider)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/viraaya?sslmode=require"

# Cloudflare R2 (S3-compatible API — object storage only, no Workers/D1)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="viraaya-media"
# Optional public CDN URL if you serve media from a custom domain
# R2_PUBLIC_BASE_URL="https://media.viraayaweddings.com"
