{
  "name": "viraaya-weddings-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/verify-vercel-output.mjs",
    "start": "vinext start",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ci": "npm run test && npm run build",
    "lint": "eslint app worker vite.config.ts next.config.ts eslint.config.mjs --ignore-pattern dist --ignore-pattern .next",
    "docs:inventory": "node scripts/docs-inventory.mjs",
    "docs:validate": "node scripts/docs-validate.mjs",
    "docs:sync": "node scripts/docs-sync.mjs",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node --experimental-strip-types scripts/db-seed.ts",
    "media:upload-static": "node scripts/upload-static-images-to-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@tailwindcss/postcss": "4.2.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^0.0.45",
    "vite": "8.2.1"
  },
  "type": "module"
}
